# Required environment variables for the RAG API
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to Git.

# HF API key (Required for cloud embeddings — skip to download models locally)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_key_here

# ---------------------------------------------------------------------------
# Groq API Key (required)
# Get yours free at: https://console.groq.com
# Used to power all LLM responses (Llama, Qwen, etc.)
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
